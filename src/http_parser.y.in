%language "c++"

@DEFINE_TRACE@ 

%skeleton "lalr1.cc"
%param { std::pair<FlexLexer*, http_server::request::Request*> flexNRequest }
%define api.value.type variant

%code requires
{
  #include <string>
  #include <utility>
  #include <sstream>
  #include <iostream>
  #include <map>

  #include "request.hpp"
  #include "header.hpp"
  #include "method.hpp"

  class FlexLexer; 
}

%code 
{
  #include <FlexLexer.h>

  namespace yy {
      parser::token_type yylex(
        parser::semantic_type* yylval, 
        std::pair<FlexLexer*, http_server::request::Request*> flexNRequest); 
  }

  static std::stringstream content;
  static std::stringstream uriSS;

  std::map<std::string, http_server::method::Method> methods {
      {"GET", http_server::method::Method::GET},
      {"POST", http_server::method::Method::POST},
      {"PUT", http_server::method::Method::PUT},
      {"DELETE", http_server::method::Method::DELETE},
      {"PATCH", http_server::method::Method::PATCH},
      {"HEAD", http_server::method::Method::HEAD},
      {"OPTIONS", http_server::method::Method::OPTIONS},
      {"CONNECT", http_server::method::Method::CONNECT},
      {"TRACE", http_server::method::Method::TRACE}
  };

  auto getMethod(const std::string& str) {
    if (!methods.contains(str)) {
      return http_server::method::Method::ERR;
    }
    return methods[str];
  }
}


%defines

%token HTTP
%token<std::string> NUMBER
%token DOT
%token COLON
%token SPACE
%token CR
%token LF
%token<std::string> STRING
%token SLASH
%nterm req_line
%nterm headers
%nterm msg_body
%nterm header
%nterm spaces
%nterm msg_body_char
%nterm opt_msg_body
%nterm uri
%nterm uri_char
%nterm header_msg
%nterm opt_spaces

%start request

%%

request:        req_line headers CR LF opt_msg_body                       { 
                                                                             flexNRequest.second->setContent(content.str()); 
                                                                             content.str(""); 
                                                                             content.clear(); 
                                                                          }  

req_line:       STRING SPACE uri SPACE HTTP SLASH NUMBER DOT NUMBER CR LF {
                                                                            flexNRequest.second->setMethod(getMethod($1));
                                                                            flexNRequest.second->setUri(uriSS.str());
                                                                            uriSS.str("");
                                                                            uriSS.clear();
                                                                            flexNRequest.second->sethttpVersionMajor(std::stoi($7));
                                                                            flexNRequest.second->sethttpVersionMinor(std::stoi($9));
                                                                          }

uri_char:       HTTP                                                      { uriSS << "HTTP"; }
          |     NUMBER                                                    { uriSS << $1;     }
          |     DOT                                                       { uriSS << '.';    }
          |     COLON                                                     { uriSS << ':';    }
          |     STRING                                                    { uriSS << $1;     }
          |     SLASH                                                     { uriSS << '/';    }

uri:            uri_char
          |     uri uri_char

headers:        header
          |     headers header

header:         STRING opt_spaces COLON opt_spaces header_msg CR LF       { 
                                                                            http_server::header::Header h; 
                                                                            h.name = std::move($1);
                                                                            h.value = uriSS.str();
                                                                            uriSS.str("");
                                                                            uriSS.clear();
                                                                            flexNRequest.second->addHeader(std::move(h)); 
                                                                          }

header_msg:     uri_char
          |     header_msg uri_char
          |     header_msg SPACE                                          { uriSS << ' '; }


opt_spaces:     /* empty */
          |     spaces

spaces:         SPACE
          |     spaces SPACE

msg_body_char:  HTTP                                                      { content << "HTTP";       }
             |  NUMBER                                                    { content << $1;           }
             |  DOT                                                       { content << '.';          }
             |  COLON                                                     { content << ':';          }
             |  SPACE                                                     { content << ' ';          }
             |  CR                                                        { content << '\r';         }
             |  LF                                                        { content << '\n';         }
             |  STRING                                                    { content << $1;           }
             |  SLASH                                                     { content << '/';          }

msg_body:       msg_body_char
             |  msg_body msg_body_char    

opt_msg_body:   /* empty */
            |   msg_body 

%%

namespace yy {
parser::token_type yylex(
  parser::semantic_type* yylval, 
  std::pair<FlexLexer*, http_server::request::Request*> flexNRequest) 
{   
    auto* lexer = flexNRequest.first;
    auto tt = static_cast<parser::token_type>(lexer->yylex());
     switch (tt) {
        case (yy::parser::token_type::NUMBER): 
        case (yy::parser::token_type::STRING):
            yylval->emplace<std::string>() = 
                std::string(lexer->YYText(), lexer->YYLeng());
            break;
    }
    return tt;
}

  void parser::error(const std::string&) { }
}